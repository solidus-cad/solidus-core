{
  "name": "@solidus-cad/kernel-wasm",
  "version": "0.1.0",
  "description": "C++ kernel of Solidus (cad-core) compiled to WebAssembly: client, bindings and binaries.",
  "license": "AGPL-3.0-only WITH AdditionRef-Solidus-Plugin-Exception",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidus-cad/solidus-core.git",
    "directory": "packages/kernel-wasm"
  },
  "homepage": "https://github.com/solidus-cad/solidus-core#readme",
  "bugs": "https://github.com/solidus-cad/solidus-core/issues",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "LICENSE",
    "LICENSE-EXCEPTION.txt",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json",
      "./engine": {
        "types": "./lib/engine.d.ts",
        "default": "./lib/engine.js"
      },
      "./kernel.wasm": "./dist/kernel.wasm",
      "./kernel.js": "./dist/kernel.js"
    }
  },
  "scripts": {
    "build:kernel": "bash ../../tools/build-kernel.sh wasm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test --exclude test/memory.test.ts",
    "test:memory": "vitest run test/memory.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepack": "pnpm clean && pnpm build && node ../../tools/prepack.mjs lib --kernel"
  },
  "dependencies": {
    "@solidus-cad/sdk": "workspace:*",
    "@solidus-cad/sketch": "workspace:*",
    "@salusoft89/planegcs": "^1.3.0"
  }
}
