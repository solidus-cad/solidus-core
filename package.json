{
  "name": "cad",
  "private": true,
  "license": "AGPL-3.0-only WITH AdditionRef-Solidus-Plugin-Exception",
  "scripts": {
    "dev": "pnpm --filter @solidus-cad/web dev",
    "build": "pnpm --filter @solidus-cad/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @solidus-cad/web exec playwright test",
    "desktop:dev": "pnpm --filter @solidus-cad/desktop dev",
    "desktop:version": "node tools/desktop/release.mjs version",
    "desktop:build": "node tools/desktop/release.mjs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:dry": "pnpm -r --filter \"./packages/{sdk,assembly,sketch}\" exec pnpm publish --dry-run --no-git-checks",
    "release": "changeset publish"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
